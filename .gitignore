# Build inputs come from hpe-altloader and are not tracked here
/src/*
!/src/README.md

# Credentials (rule 10), never committed
.env
.env.*
!.env.example
.envrc
.secret*
*.pem
*.key
*.p12
*.pfx
auth.json
.npmrc

# Claude Code
.claude/settings.local.json

# Scratch (rule 10 tmp/ convention)
tmp/

# OS artifacts
.DS_Store
._*
Thumbs.db
Desktop.ini

# Editor files
.idea
.vscode/
*.swp
